ANTHROPIC_API_KEY=

# Google Calendar integration
# Phase 2 needs the read-write scope (calendar.events). Re-mint
# GOOGLE_REFRESH_TOKEN with that scope — a calendar.readonly token 403s on writes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Maps integration (travel times + place lookup)
# Uses a plain API key, NOT OAuth — no refresh token here. Create the key in the
# same Google Cloud project (APIs & Services -> Credentials) and enable the
# "Distance Matrix API" and "Places API" on it.
GOOGLE_MAPS_API_KEY=

# Saved places for the Maps tools. Jarvis can pass "home" or "work" as an
# origin/destination and they resolve to these. Kept here (not in the About Ben
# profile) so the addresses only enter a request when a map tool needs them,
# rather than sitting in every prompt. Leave blank to disable the shortcut.
JARVIS_HOME_ADDRESS=
JARVIS_WORK_ADDRESS=

# Tone of voice. Default (unset or anything else) is the Iron Man J.A.R.V.I.S.
# persona: dry, British, calls Ben "sir". Set to off/false/0/none/plain for a
# neutral assistant voice.
JARVIS_PERSONA=True

# Trello integration
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Inbound email. Ben forwards booking/event confirmations here with an
# instruction; Jarvis acts on them and replies in one line. Leave either blank
# to disable polling entirely.
# ADDRESS is the alias mail arrives on (a plus-address on the same Google
# account the calendar uses, e.g. you+jarvis@gmail.com), and is also the From
# on replies. ALLOWED is a comma-separated whitelist of senders — anything
# else is read and ignored silently, with no bounce.
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_ALLOWED=
