ANTHROPIC_API_KEY=

# Google Calendar integration
# Phase 2 needs the read-write scope (calendar.events). Re-mint
# GOOGLE_REFRESH_TOKEN with that scope — a calendar.readonly token 403s on writes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Maps integration (travel times + place lookup)
# Uses a plain API key, NOT OAuth — no refresh token here. Create the key in the
# same Google Cloud project (APIs & Services -> Credentials) and enable the
# "Distance Matrix API" and "Places API" on it.
GOOGLE_MAPS_API_KEY=

# Trello integration
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
